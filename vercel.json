{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gestaltung360.com"
        }
      ],
      "destination": "https://gestaltung360.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/delivery-promises",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/voltaat-sync",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/supplier-refresh",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "30 4 * * *"
    }
  ]
}
