# .env.example — every environment variable this app reads, with what it is for.
# Copy to .env.local and fill in values. NEVER commit real values.
# Server-only unless the name starts with NEXT_PUBLIC_ (those reach the browser).

# ── CAD Champions (/cad-champions) ─────────────────────────────────────────────
# WhatsApp number for the "Need help?" sheet, digits only with country code (e.g. 974XXXXXXXX).
# Falls back to NEXT_PUBLIC_WHATSAPP_NUMBER; when neither is set the WhatsApp row is hidden.
WHATSAPP_NUMBER=
# Support email shown in "Need help?" and the CC footer. Default: info@gestaltung360.com
SUPPORT_EMAIL=
# Set to 1 to show the dev-only UI gallery (/cad-champions/{en,ar}/dev/ui) in a production build.
CC_DEV_GALLERY=
# STEP auto-grader service (Cloud Run, /grader). Without these the practice upload and test
# grading fall back to a header-only check and mark results "checking manually".
GRADER_URL=                           # e.g. https://cad-grader-xxxx-ew.a.run.app
GRADER_SECRET=                        # shared secret sent as X-Grader-Secret (same value as the Cloud Run secret)
# Bunny Stream lesson videos (Prompt 9). Server-only. Lessons store Bunny video GUIDs; the server signs
# 2-hour embed links (token = SHA256(key + videoId + expires)). Without these, lessons show "video coming soon".
BUNNY_LIBRARY_ID=                     # Stream library id (number in the Bunny dashboard)
BUNNY_TOKEN_KEY=                      # library > Security > Embed view token authentication key (never sent to the browser)
BUNNY_CDN_HOST=                       # optional embed host; default iframe.mediadelivery.net
# CAD Champions AI drawing check + comment translation (Prompt 8). Server-only; without a key drawings go straight to trainer review.
ANTHROPIC_API_KEY=                    # Anthropic API key (never sent to the browser)
ANTHROPIC_MODEL=                      # optional; default claude-sonnet-5-5
# CAD Champions payments (Prompt 10). Fawran = manual transfer + proof + admin approval.
# Our Fawran details on the signed-in Pay step and in the reservation email (IBAN never on public pages).
# Each falls back to lib/company.ts PAYMENT_DETAILS when empty (mobile has no fallback: row hidden).
FAWRAN_ALIAS=                         # e.g. CR-236988
FAWRAN_MOBILE=                        # optional mobile number registered for Fawran
FAWRAN_IBAN=                          # IBAN of the receiving account
FAWRAN_ACCOUNT_NAME=                  # account holder name as the bank shows it
FAWRAN_BANK_NAME=                     # e.g. Qatar International Islamic Bank (QIIB)
CC_PAYMENTS_ALERT_EMAIL=              # optional; where "new payment proof" alerts go (default STORE_LEAD_EMAIL / info@)
# SkipCash hosted card / Apple Pay page: BUILT but OFF until SKIPCASH_ENABLED=true AND all keys below are set.
SKIPCASH_ENABLED=                     # "true" to show "Pay by card / Apple Pay"
SKIPCASH_BASE_URL=                    # https://skipcashtest.azurewebsites.net (sandbox, default) or https://api.skipcash.app
SKIPCASH_CLIENT_ID=                   # merchant Client ID (sent to read a payment's status)
SKIPCASH_KEY_ID=                      # KeyId sent in the create request
SKIPCASH_KEY_SECRET=                  # secret for the HMAC-SHA256 request signature (server only)
SKIPCASH_WEBHOOK_KEY=                 # webhook key from the merchant portal; webhooks are refused while empty
# Receipt letterhead (falls back to lib/company.ts COMPANY / COMPANY_ADDRESS). [TODO-MO]
CC_RECEIPT_CR_NUMBER=                 # C.R. number printed on receipts
CC_RECEIPT_ADDRESS_EN=                # address line, English
CC_RECEIPT_ADDRESS_AR=                # address line, Arabic

# ── Site + Supabase ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=                 # e.g. https://gestaltung360.com (absolute links in emails/SEO)
NEXT_PUBLIC_SUPABASE_URL=             # Supabase project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # Supabase anon/publishable key (public, RLS-protected)
SUPABASE_SERVICE_ROLE_KEY=            # Supabase service role key — server only, bypasses RLS
NEXT_PUBLIC_WHATSAPP_NUMBER=          # Main-site WhatsApp number, digits only
NEXT_PUBLIC_GA_MEASUREMENT_ID=        # GA4 ID, loaded only after cookie Accept

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=                       # Resend API key
RESEND_FROM=                          # Sender, e.g. "Gestaltung <noreply@contact.gestaltung360.com>"
STORE_LEAD_EMAIL=                     # Where lead/quote emails go (default info@gestaltung360.com)

# ── Bot check (Cloudflare Turnstile, optional) ───────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── AI providers ─────────────────────────────────────────────────────────────
ANALYSIS_PROVIDER=                    # gemini | rules
GEMINI_API_KEY=
GEMINI_MODEL=                         # optional override
GEMINI_FALLBACK_MODEL=                # optional override
GROQ_API_KEY=                         # voice transcription
GROQ_WHISPER_MODEL=                   # optional override
AI_RATE_SALT=                         # salt for hashing guest IPs in rate limits
AI_RESET_TZ_GEMINI=                   # optional quota reset time zone override
AI_RESET_TZ_GROQ=                     # optional quota reset time zone override

# ── Cloud CAD worker (Google Cloud Run, optional) ────────────────────────────
GCP_CAD_URL=
GCP_WIF_PROVIDER=
GCP_CAD_SA_EMAIL=
GCP_CAD_SA_KEY=                       # legacy fallback; prefer keyless WIF
CAD_WORKER_TOKEN=

# ── Suppliers ────────────────────────────────────────────────────────────────
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
STORE_SHEET_CSV_URL=                  # published Google Sheet CSV for store import

# ── Google (Drive picker, YouTube upload) ────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
GOOGLE_OAUTH_CLIENT_ID=               # optional; falls back to NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=
INTEGRATIONS_ENC_KEY=                 # AES key for stored OAuth refresh tokens

# ── Cron + misc ──────────────────────────────────────────────────────────────
CRON_SECRET=                          # Vercel cron auth
INTERNAL_API_SECRET=                  # optional: server-to-server auth for /api/admin/store-image (falls back to CRON_SECRET)
EXPORT_DEV_OWNER=                     # dev only: 1 lets a project owner export locally
NETLIST_TEST_BREAK=                   # dev only: 1 corrupts a netlist to test retries
