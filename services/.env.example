# services/.env — the Mac Mini stack's settings (docs/WORKER.md, step 5).
# Copy this file to .env in the same folder and type each value yourself.
# NAMES ONLY here: never commit .env, never paste these values into a chat.

# --- shared with Vercel ---------------------------------------------------
# A long random string (at least 32 characters). The SAME value goes into
# Vercel as WORKER_SECRET.
WORKER_SECRET=

# --- Supabase (Supabase dashboard -> Project Settings -> API) ---------------
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- the public site ---------------------------------------------------------
NEXT_PUBLIC_SITE_URL=
# Optional: where cache purges are sent (default NEXT_PUBLIC_SITE_URL).
REVALIDATE_URL=
# Optional: "off" stops the worker's own schedules (manual /jobs calls still work).
WORKER_SCHEDULES=

# --- email (same values as in Vercel) ----------------------------------------
RESEND_API_KEY=
RESEND_FROM=
STORE_LEAD_EMAIL=
CC_ALERT_EMAIL=
CC_PAYMENTS_ALERT_EMAIL=

# --- supplier syncs (same values as in Vercel) -------------------------------
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=

# --- YouTube retire job (same values as in Vercel) ----------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
INTEGRATIONS_ENC_KEY=

# --- order rating links in emails (same value as in Vercel) -------------------
ORDER_RATING_SECRET=

# --- CAD services on this Mac (part B) ----------------------------------------
CAD_WORKER_TOKEN=
GRADER_SECRET=
GRADER_ALLOWED_URL_PREFIXES=

# --- Cloudflare Tunnel (Cloudflare dashboard -> Networking -> Tunnels -> your tunnel) ---
CLOUDFLARE_TUNNEL_TOKEN=
